<% content_for(:title) { "Sign In - Show Notes" } %>

<div class="flex-1 flex items-center justify-center px-4 py-16">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="flex justify-center mb-5">
        <%= render "shared/sn_mark", size: 56 %>
      </div>
      <h1 class="font-serif text-3xl font-bold tracking-tight text-cream">Welcome to Show Notes</h1>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber mt-3">Enter your email to sign in</p>
    </div>

    <div class="bg-paper text-ink rounded-2xl p-6 sm:p-7 shadow-2xl">
      <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="email" class="block font-mono text-xs uppercase tracking-wide text-ink-muted mb-2">
            Email address
          </label>
          <input
            type="email"
            name="email"
            id="email"
            value="<%= @email %>"
            autofocus
            required
            placeholder="you@company.com"
            class="w-full font-mono px-4 py-3 border border-ink/15 rounded-lg focus:ring-2 focus:ring-amber/30 focus:border-amber focus:outline-none transition"
          >
        </div>

        <button
          type="submit"
          class="w-full font-serif font-semibold text-ink bg-amber py-3 px-4 rounded-lg hover:brightness-105 transition focus:outline-none focus:ring-2 focus:ring-amber/40 focus:ring-offset-2 focus:ring-offset-paper"
        >
          Send magic link
        </button>
      <% end %>
    </div>

    <p class="text-center font-mono text-xs tracking-wide text-cream/55 mt-6">
      We'll email you a link to sign in. No password needed.
    </p>
  </div>
</div>
