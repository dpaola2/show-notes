<% content_for(:title) { "Check Your Email - Show Notes" } %>

<div class="flex-1 flex items-center justify-center px-4 py-16">
  <div class="w-full max-w-md text-center">
    <div class="flex justify-center mb-6">
      <div class="w-16 h-16 bg-cream/10 border border-amber/40 rounded-full flex items-center justify-center">
        <svg class="w-8 h-8 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
    </div>

    <h1 class="font-serif text-3xl font-bold tracking-tight text-cream mb-3">Check your email</h1>
    <p class="text-cream/80 leading-relaxed mb-6">
      We've sent you a magic link to sign in. Click the link in the email to continue.
    </p>

    <div class="bg-cream/5 border border-cream/15 rounded-lg p-4 text-left">
      <div class="flex gap-3">
        <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div class="text-sm text-cream/75">
          <p class="font-mono text-xs uppercase tracking-wide text-cream">Link expires in 15 minutes</p>
          <p class="mt-1">Check your spam folder if you don't see the email.</p>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= link_to "Back to sign in", login_path, class: "font-mono text-sm text-amber hover:underline" %>
    </div>
  </div>
</div>
