<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Show Notes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="index, follow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= render "shared/analytics" %>
  </head>

  <body class="bg-paper text-ink min-h-screen flex flex-col">
    <header class="bg-navy text-cream">
      <div class="max-w-3xl mx-auto px-4 h-14 flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2.5 hover:opacity-90 transition" do %>
          <%= render "shared/sn_mark", size: 28 %>
          <span class="font-serif text-lg font-semibold tracking-tight">Show Notes</span>
        <% end %>
        <span class="flex-1"></span>
        <%= link_to "Sign in", login_path, class: "font-mono text-xs tracking-wide text-cream/70 hover:text-cream transition" %>
      </div>
    </header>

    <main class="flex-1">
      <%= yield %>
    </main>

    <footer class="border-t border-ink/10 py-5">
      <div class="max-w-3xl mx-auto px-4">
        <p class="text-center font-mono text-xs tracking-wide text-ink-muted">
          Show Notes · Read-first podcast summaries powered by AI
        </p>
        <p class="text-center font-mono text-xs mt-2">
          <%= link_to "Privacy", privacy_path, class: "text-ink-muted hover:text-amber hover:underline" %>
          <span class="text-ink-muted/50">·</span>
          <%= link_to "Support", support_path, class: "text-ink-muted hover:text-amber hover:underline" %>
        </p>
      </div>
    </footer>
  </body>
</html>
