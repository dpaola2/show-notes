<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Show Notes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Show Notes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "shared/favicons" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= render "shared/analytics" %>
  </head>

  <body class="bg-navy text-cream min-h-screen flex flex-col">
    <% if flash[:notice].present? %>
      <div class="fixed top-4 right-4 z-50 bg-cream border border-amber text-ink px-4 py-3 rounded-lg shadow-lg max-w-sm"
           role="alert" data-controller="flash" data-flash-dismiss-after-value="5000">
        <span class="font-mono text-sm"><%= flash[:notice] %></span>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="fixed top-4 right-4 z-50 bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded-lg shadow-lg max-w-sm"
           role="alert" data-controller="flash" data-flash-dismiss-after-value="5000">
        <span class="font-mono text-sm"><%= flash[:alert] %></span>
      </div>
    <% end %>

    <main class="flex-1 flex flex-col">
      <%= yield %>
    </main>

    <footer class="py-5">
      <p class="text-center font-mono text-xs tracking-wide text-cream/45">
        Show Notes · Read-first podcast summaries powered by AI
      </p>
    </footer>
  </body>
</html>
