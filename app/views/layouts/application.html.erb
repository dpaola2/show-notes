<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Show Notes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Show Notes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "shared/favicons" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= render "shared/analytics" %>
  </head>

  <body class="bg-paper text-ink min-h-screen flex flex-col">
    <header class="bg-navy text-cream border-b border-cream/10 sticky top-0 z-40">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center gap-2.5 hover:opacity-90 transition" do %>
              <%= render "shared/sn_mark", size: 30 %>
              <span class="hidden sm:inline font-serif text-lg font-semibold tracking-tight">Show Notes</span>
            <% end %>
          </div>

          <% nav_active = "bg-cream/10 text-cream" %>
          <% nav_idle = "text-cream/65 hover:bg-cream/5 hover:text-cream" %>
          <div class="flex items-center gap-0.5 sm:gap-1.5 font-mono text-xs tracking-wide">
            <%= link_to inbox_index_path,
                class: "relative p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/inbox') || request.path == '/' ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Inbox</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
              </span>
              <% if inbox_count > 0 %>
                <span class="absolute -top-0.5 -right-0.5 min-w-[1.25rem] h-5 px-1 flex items-center justify-center text-xs font-bold text-ink bg-amber rounded-full">
                  <%= inbox_count > 99 ? "99+" : inbox_count %>
                </span>
              <% end %>
            <% end %>

            <%= link_to library_index_path,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/library') ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Library</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </span>
            <% end %>

            <%= link_to archive_index_path,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/archive') ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Archive</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                </svg>
              </span>
            <% end %>

            <div class="w-px h-6 bg-cream/15 mx-0.5 hidden sm:block"></div>

            <%= link_to podcasts_path,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/podcasts') ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Find</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </span>
            <% end %>

            <%= link_to subscriptions_path,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/subscriptions') ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Podcasts</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                </svg>
              </span>
            <% end %>

            <div class="w-px h-6 bg-cream/15 mx-0.5 hidden sm:block"></div>

            <%= link_to settings_path,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{request.path.start_with?('/settings') ? nav_active : nav_idle}" do %>
              <span class="hidden sm:inline">Settings</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
            <% end %>

            <%= button_to logout_path,
                method: :delete,
                class: "p-3 sm:px-3 sm:py-2 rounded-lg transition #{nav_idle}",
                data: { turbo_confirm: "Are you sure you want to sign out?" } do %>
              <span class="hidden sm:inline">Sign Out</span>
              <span class="sm:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
              </span>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <% if flash[:notice].present? %>
      <div class="fixed top-20 right-4 z-50 bg-cream border border-amber text-ink px-4 py-3 rounded-lg shadow-lg max-w-sm"
           role="alert"
           data-controller="flash"
           data-flash-dismiss-after-value="5000">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 flex-shrink-0 text-amber" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="font-mono text-sm"><%= flash[:notice] %></span>
        </div>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="fixed top-20 right-4 z-50 bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded-lg shadow-lg max-w-sm"
           role="alert"
           data-controller="flash"
           data-flash-dismiss-after-value="5000">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <span class="font-mono text-sm"><%= flash[:alert] %></span>
        </div>
      </div>
    <% end %>

    <main class="flex-1 py-6">
      <%= yield %>
    </main>

    <footer class="bg-navy text-cream/55 py-5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center font-mono text-xs tracking-wide">
          Show Notes · Read-first podcast summaries powered by AI
        </p>
      </div>
    </footer>
  </body>
</html>
