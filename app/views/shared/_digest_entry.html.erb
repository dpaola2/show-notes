<%# One episode summary in the digest mockup.
    locals: show, title, minutes, listen, body, quote (optional), featured (bool), accent %>
<% featured = false if featured.nil? %>
<% quote ||= nil %>
<article style="padding:<%= featured ? "0 0 26px" : "20px 0" %>;<%= featured ? "" : "border-top:1px solid rgba(26,24,20,0.12);" %>">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:9px">
    <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.16em;text-transform:uppercase;color:<%= accent %>;font-weight:500"><%= show %></span>
    <span style="flex:1;height:1px;background:rgba(26,24,20,0.12)"></span>
    <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#8a8475;letter-spacing:0.04em"><%= minutes %> min read</span>
  </div>
  <h4 style="margin:0 0 8px;font-family:'Source Serif 4',Georgia,serif;font-weight:600;font-size:<%= featured ? "27px" : "21px" %>;line-height:1.18;letter-spacing:-0.015em;color:#1A1814"><%= title %></h4>
  <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-weight:400;font-size:<%= featured ? "16px" : "14.5px" %>;line-height:1.62;color:#3a352c"><%= body %></p>
  <% if quote %>
    <blockquote style="margin:16px 0 4px;padding:4px 0 4px 18px;border-left:3px solid <%= accent %>;font-family:'Source Serif 4',Georgia,serif;font-style:italic;font-weight:400;font-size:17px;line-height:1.5;color:#1A1814"><%= quote %></blockquote>
  <% end %>
  <div style="display:flex;align-items:center;gap:12px;margin-top:14px">
    <%= render "shared/mini_wave", accent: accent, muted: true %>
    <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;color:#8a8475;letter-spacing:0.04em">Listen · <%= listen %></span>
  </div>
</article>
