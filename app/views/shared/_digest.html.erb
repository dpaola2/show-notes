<%# The daily digest "paper" email mockup — the product's most persuasive asset.
    locals: variant ('hero' compact | 'full'), accent %>
<% variant ||= "full" %>
<% accent ||= "#D9883F" %>
<% compact = variant == "hero" %>
<div style="background:linear-gradient(180deg,#FBF6EA 0%,#F3E9D3 100%);border-radius:14px;box-shadow:0 40px 80px -40px rgba(0,0,0,0.55),0 12px 30px -16px rgba(0,0,0,0.35);overflow:hidden;width:100%;border:1px solid rgba(26,24,20,0.06)">
  <%# Masthead %>
  <div style="padding:<%= compact ? "22px 26px 16px" : "34px 40px 22px" %>;text-align:center;border-bottom:2px solid #1A1814">
    <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.34em;text-transform:uppercase;color:#8a8475;margin-bottom:10px">Your morning digest</div>
    <div style="font-family:'Source Serif 4',Georgia,serif;font-weight:700;font-size:<%= compact ? "30px" : "40px" %>;letter-spacing:0.02em;color:#1A1814;line-height:1">Show&#8202;Notes</div>
    <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:<%= accent %>;margin-top:10px;font-weight:500">Daily · Saturday, May 31</div>
  </div>

  <%# Intro %>
  <div style="padding:<%= compact ? "18px 26px 4px" : "26px 40px 6px" %>">
    <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-style:italic;font-size:<%= compact ? "14px" : "16px" %>;line-height:1.55;color:#5a5446">
      <%= compact ? "Nine new episodes across your shows. The two that matter most:" : "Nine new episodes across your shows since yesterday. Here is what happened — about a six-minute read." %>
    </p>
  </div>

  <%# Entries %>
  <div style="padding:<%= compact ? "14px 26px 24px" : "18px 40px 8px" %>">
    <%= render "shared/digest_entry", accent: accent, featured: true, show: "Latent Space", minutes: "4", listen: "1h 12m",
          title: "The real economics of inference",
          body: "Margins on serving large models are thinner than anyone admits. The guest walks through why batching, quantization, and speculative decoding moved from research tricks to the only things keeping a token business solvent — and why the next round of price cuts comes from hardware, not models.",
          quote: (compact ? nil : "“The model is the loss leader. The serving stack is the product.”") %>
    <%= render "shared/digest_entry", accent: accent, show: "Acquired", minutes: "6", listen: "3h 04m",
          title: "How a chip company became an operating system",
          body: "A long history of how a single decision — to ship a programming layer alongside the silicon — quietly built a fifteen-year moat. The hosts trace the bets that looked like distractions at the time and compounded into lock-in." %>
    <% unless compact %>
      <%= render "shared/digest_entry", accent: accent, show: "Huberman Lab", minutes: "3", listen: "1h 48m",
            title: "Protocols for sustained focus",
            body: "Practical, not mystical: light exposure timing, a 90-minute work cadence, and why the urge to check your phone spikes at predictable intervals. Skip the supplement segment; the first forty minutes carry the episode." %>
      <div style="display:flex;align-items:center;gap:14px;padding:22px 0 14px">
        <span style="flex:1;height:1px;background:rgba(26,24,20,0.18)"></span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.22em;text-transform:uppercase;color:#8a8475">Also today</span>
        <span style="flex:1;height:1px;background:rgba(26,24,20,0.18)"></span>
      </div>
      <%= render "shared/digest_entry", accent: accent, show: "EconTalk", minutes: "5", listen: "1h 06m",
            title: "Why good institutions are hard to copy",
            body: "A conversation on why importing the rules of a functioning system rarely imports the result. The interesting turn: trust is the expensive part, and it cannot be legislated into existence." %>
      <%= render "shared/digest_entry", accent: accent, show: "Lenny's Podcast", minutes: "4", listen: "1h 22m",
            title: "The first product hire at a growing startup",
            body: "What actually changes when you go from founder-led product to your first PM. Concrete on the handoff failure modes, less so on titles. Worth it if you are about to make this hire." %>
    <% end %>
  </div>

  <%# Email footer %>
  <div style="padding:<%= compact ? "4px 26px 22px" : "10px 40px 30px" %>;text-align:center">
    <div style="display:inline-flex;align-items:center;gap:9px;opacity:0.6">
      <%= render "shared/sn_mark", size: 18, accent: accent %>
      <span style="font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:0.18em;text-transform:uppercase;color:#8a8475">Tomorrow, same time</span>
    </div>
  </div>
</div>
