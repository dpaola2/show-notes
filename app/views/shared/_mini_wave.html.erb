<%# Small inline waveform "listen" cue. locals: accent, muted %>
<% accent ||= "#D9883F" %>
<% muted = false if muted.nil? %>
<svg width="64" height="22" viewBox="0 0 96 32" style="display:block" aria-hidden="true">
  <g fill="<%= muted ? "#B7A98A" : accent %>">
    <% [5, 9, 14, 8, 18, 11, 6, 13, 9, 16, 7, 10, 5].each_with_index do |h, i| %>
      <rect x="<%= (i * 7.4).round(2) %>" y="<%= 16 - h %>" width="3.4" height="<%= h * 2 %>" rx="1.5" />
    <% end %>
  </g>
</svg>
