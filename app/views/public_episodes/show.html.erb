<% content_for(:title) { "#{@episode.title} — #{@podcast.title} | Show Notes" } %>

<% content_for(:head) do %>
  <meta property="og:title" content="<%= truncate(@episode.title, length: 80) %>">
  <meta property="og:description" content="<%= @summary ? @summary.sections.first&.dig("content")&.truncate(200) : "Episode summary from #{@podcast.title}" %>">
  <meta property="og:url" content="<%= public_episode_url(@episode) %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Show Notes">
  <% if @episode.og_image.attached? %>
    <meta property="og:image" content="<%= @episode.og_image_url %>">
  <% end %>
<% end %>

<div class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
  <%# Episode header %>
  <div class="flex items-start gap-4 mb-8">
    <% if @podcast.artwork_url.present? %>
      <img src="<%= @podcast.artwork_url %>" alt="<%= @podcast.title %>" class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg shadow-sm object-cover flex-shrink-0">
    <% else %>
      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg shadow-sm bg-paper-deep flex items-center justify-center flex-shrink-0">
        <svg class="w-8 h-8 sm:w-10 sm:h-10 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
        </svg>
      </div>
    <% end %>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber mb-1.5"><%= @podcast.title %></p>
      <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink leading-tight"><%= @episode.title %></h1>
      <% if @episode.published_at %>
        <p class="font-mono text-xs text-ink-muted mt-2"><%= @episode.published_at.strftime("%B %-d, %Y") %></p>
      <% end %>
    </div>
  </div>

  <% if @summary.present? %>
    <%# Summary sections %>
    <div class="space-y-6 mb-10">
      <% @summary.sections.each do |section| %>
        <div>
          <h2 class="font-serif text-xl font-semibold tracking-tight text-ink mb-2"><%= section["title"] %></h2>
          <p class="text-lg text-ink-soft leading-relaxed"><%= section["content"] %></p>
        </div>
      <% end %>
    </div>

    <%# Quotes %>
    <% if @summary.quotes.any? %>
      <div class="space-y-4 mb-10">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber">Notable quotes</p>
        <% @summary.quotes.each do |quote| %>
          <blockquote class="border-l-4 border-amber pl-5 py-1">
            <p class="font-serif text-xl italic text-ink leading-snug">"<%= quote["text"] %>"</p>
          </blockquote>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-amber/10 border border-amber/30 rounded-xl p-5 mb-10">
      <p class="font-serif font-semibold text-ink">Summary not yet available</p>
      <p class="text-sm text-ink-soft mt-1">This episode is still being processed. Check back soon.</p>
    </div>
  <% end %>

  <%# Share button %>
  <div class="mb-10">
    <%= render "shared/share_button", episode: @episode %>
  </div>

  <%# CTA %>
  <div class="bg-navy text-cream rounded-2xl p-7 sm:p-9 text-center">
    <div class="flex justify-center mb-4"><%= render "shared/sn_mark", size: 44 %></div>
    <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight mb-3">Read your podcasts. All of them.</h2>
    <p class="text-cream/80 leading-relaxed max-w-md mx-auto mb-6">
      Show Notes turns the shows you follow into a readable inbox. Pick the episodes worth it, get a clean summary in minutes, and skip the hours of listening.
    </p>
    <%= link_to "Get started, it's free", login_path, class: "inline-flex items-center justify-center font-serif font-semibold bg-amber text-ink px-7 py-3 rounded-lg hover:brightness-105 transition" %>
    <p class="font-mono text-xs tracking-wide text-cream/50 mt-4">No password, no credit card.</p>
  </div>
</div>
