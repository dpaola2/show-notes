<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex gap-6 mb-8">
    <% if @podcast.artwork_url.present? %>
      <img src="<%= @podcast.artwork_url %>"
           alt="<%= @podcast.title %> artwork"
           class="w-32 h-32 rounded-lg object-cover flex-shrink-0 shadow-sm">
    <% else %>
      <div class="w-32 h-32 rounded-lg bg-paper-deep flex items-center justify-center flex-shrink-0">
        <svg class="w-12 h-12 text-ink-muted" fill="currentColor" viewBox="0 0 20 20">
          <path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>
        </svg>
      </div>
    <% end %>

    <div class="flex-1">
      <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-2"><%= @podcast.title %></h1>
      <p class="font-mono text-xs text-ink-muted mb-2"><%= @podcast.author %></p>
      <p class="text-ink-soft text-sm"><%= truncate(@podcast.description, length: 300) %></p>
    </div>
  </div>

  <h2 class="font-serif text-xl font-semibold tracking-tight text-ink mb-4">Episodes (<%= @episodes.count %>)</h2>

  <% if @episodes.any? %>
    <div class="space-y-3">
      <% @episodes.each do |episode| %>
        <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-4 sm:p-5">
          <div class="flex justify-between items-start gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="font-serif font-medium tracking-tight text-ink truncate"><%= episode.title %></h3>
              <div class="flex items-center gap-2 mt-1 text-sm">
                <% if episode.published_at.present? %>
                  <span class="font-mono text-xs text-ink-muted">
                    <%= episode.published_at.strftime("%b %d, %Y") %>
                  </span>
                <% end %>
                <% if episode.duration_seconds.present? %>
                  <span class="text-ink-muted">&middot;</span>
                  <span class="font-mono text-xs text-ink-muted">
                    <%= format_duration(episode.duration_seconds) %>
                  </span>
                <% end %>
                <% if episode.estimated_cost_cents > 0 %>
                  <span class="text-ink-muted">&middot;</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-xs font-medium <%= cost_badge_class(episode.estimated_cost_cents) %>">
                    ~<%= format_cost_cents(episode.estimated_cost_cents) %>
                  </span>
                <% end %>
              </div>
            </div>

            <div class="flex gap-2 flex-shrink-0">
              <% user_episode = current_user.user_episodes.find_by(episode: episode) %>
              <% if user_episode %>
                <span class="font-mono text-sm text-ink-muted py-2">
                  In <%= user_episode.location.humanize %>
                </span>
              <% else %>
                <%= button_to "Add to Inbox",
                    inbox_index_path(episode_id: episode.id),
                    method: :post,
                    class: "font-mono text-sm rounded-lg border border-ink/15 text-ink-muted px-4 py-2 hover:bg-paper-deep transition" %>
                <%= button_to "Add to Library",
                    add_to_library_inbox_index_path(episode_id: episode.id),
                    method: :post,
                    class: "font-serif font-semibold rounded-lg bg-amber text-ink px-5 py-2.5 hover:brightness-105 transition" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="font-mono text-sm text-ink-muted text-center py-8">No episodes found. Episodes may still be loading.</p>
  <% end %>

  <div class="mt-8">
    <%= link_to "&larr; Back to Search".html_safe, podcasts_path, class: "text-amber hover:underline font-medium" %>
  </div>
</div>
