<div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-4 sm:mb-6">Library</h1>

  <% if @user_episodes.any? %>
    <div class="space-y-3">
      <% @user_episodes.each do |user_episode| %>
        <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
          <div class="min-w-0">
            <%= link_to library_path(user_episode), class: "block" do %>
              <h3 class="font-serif font-semibold tracking-tight text-ink line-clamp-2 sm:truncate hover:text-amber transition"><%= user_episode.title %></h3>
            <% end %>
            <p class="font-mono text-xs text-ink-muted mt-1"><%= user_episode.podcast.title %></p>
            <p class="text-sm mt-2">
              <% case user_episode.processing_status %>
              <% when "pending" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-amber/15 text-amber">Pending...</span>
              <% when "downloading" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-amber/15 text-amber">Downloading audio...</span>
              <% when "transcribing" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-amber/15 text-amber">Transcribing...</span>
              <% when "summarizing" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-amber/15 text-amber">Generating summary...</span>
              <% when "ready" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-green-100 text-green-800">Ready</span>
              <% when "error" %>
                <span class="font-mono text-xs uppercase tracking-wide rounded-full px-2 py-0.5 bg-red-100 text-red-700">Failed: <%= user_episode.processing_error %></span>
                <% if user_episode.retry_count > 0 %>
                  <span class="font-mono text-xs text-ink-muted ml-1">(attempt <%= user_episode.retry_count %>)</span>
                <% end %>
              <% end %>
            </p>
          </div>

          <% if user_episode.ready? %>
            <div class="mt-4">
              <%= link_to "View Summary",
                  library_path(user_episode),
                  class: "inline-flex items-center justify-center w-full sm:w-auto font-serif font-semibold rounded-lg bg-amber text-ink px-5 py-2.5 hover:brightness-105 transition" %>
            </div>
          <% elsif user_episode.error? %>
            <div class="mt-4">
              <%= button_to "Retry",
                  retry_processing_library_path(user_episode),
                  method: :post,
                  class: "inline-flex items-center justify-center w-full sm:w-auto font-mono text-sm rounded-lg border border-ink/15 text-ink px-4 py-2 hover:bg-ink/5 transition" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @pagy.last > 1 %>
      <nav class="flex justify-center mt-6">
        <%== @pagy.series_nav %>
      </nav>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <p class="font-serif text-ink-soft leading-relaxed mb-4">Your library is empty. Add episodes from your inbox to process them.</p>
      <%= link_to "Go to Inbox", inbox_index_path, class: "text-amber hover:underline font-medium py-2 inline-block" %>
    </div>
  <% end %>
</div>
