<div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
  <div class="mb-4 sm:mb-6">
    <%= link_to "&larr; Back to Library".html_safe, library_index_path, class: "text-amber hover:underline font-medium inline-block py-1" %>
  </div>

  <div class="flex items-start justify-between mb-2">
    <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink"><%= @episode.title %></h1>
    <%= render "shared/share_button", episode: @episode %>
  </div>
  <p class="font-mono text-xs text-ink-muted"><%= @episode.podcast.title %></p>
  <% if @episode.published_at.present? %>
    <p class="font-mono text-xs text-ink-muted mt-1 mb-4 sm:mb-6"><%= @episode.published_at.strftime("%b %d, %Y") %></p>
  <% else %>
    <div class="mb-4 sm:mb-6"></div>
  <% end %>

  <% if @user_episode.ready? && @episode.summary.present? %>
    <section class="mb-6 sm:mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber mb-3 sm:mb-4">Summary</p>

      <div class="space-y-4 sm:space-y-6 max-w-2xl">
        <% @episode.summary.sections.each do |section| %>
          <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
            <h3 class="font-serif text-lg font-semibold tracking-tight text-ink mb-2"><%= section["title"] %></h3>
            <p class="font-serif text-ink-soft text-lg leading-relaxed"><%= section["content"] %></p>
          </div>
        <% end %>
      </div>

      <% if @episode.summary.quotes.any? %>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber mt-6 mb-3 sm:mb-4">Notable Quotes</p>
        <div class="space-y-3 max-w-2xl">
          <% @episode.summary.quotes.each do |quote| %>
            <blockquote class="border-l-4 border-amber pl-4 py-3 bg-amber/10 rounded-r cursor-pointer hover:bg-amber/15 active:bg-amber/15 transition"
                        data-controller="audio-seek"
                        data-audio-seek-time-value="<%= quote['start_time'] %>"
                        data-action="click->audio-seek#seek">
              <p class="font-serif text-ink text-lg leading-relaxed">"<%= quote["text"] %>"</p>
              <p class="font-mono text-xs text-ink-muted mt-2">
                <%= format_duration(quote["start_time"].to_i) %>
              </p>
            </blockquote>
          <% end %>
        </div>
      <% end %>
    </section>

    <details class="mb-6 sm:mb-8">
      <summary class="cursor-pointer font-mono text-sm text-ink-soft hover:text-ink py-2">Original Show Notes</summary>
      <div class="mt-3 sm:mt-4 prose prose-sm max-w-none text-ink-soft">
        <%= sanitize @episode.description %>
      </div>
    </details>

    <section class="mb-6 sm:mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber mb-3 sm:mb-4">Audio</p>
      <audio controls
             src="<%= @episode.audio_url %>"
             class="w-full"
             data-controller="audio-player">
      </audio>
    </section>

    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
      <%= button_to "Mark as Done",
          archive_library_path(@user_episode),
          method: :post,
          class: "inline-flex items-center justify-center w-full sm:w-auto font-serif font-semibold rounded-lg bg-amber text-ink px-5 py-2.5 hover:brightness-105 transition text-center" %>
      <%= button_to "Regenerate Summary",
          regenerate_library_path(@user_episode),
          method: :post,
          class: "inline-flex items-center justify-center w-full sm:w-auto font-mono text-sm rounded-lg border border-ink/15 text-ink px-4 py-2 hover:bg-ink/5 transition text-center" %>
    </div>
  <% elsif @user_episode.error? %>
    <div class="bg-white rounded-xl border border-red-200 shadow-sm p-5 sm:p-6">
      <p class="font-serif text-red-700 leading-relaxed">Processing failed: <%= @user_episode.processing_error %></p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-3 sm:mt-4">
        <%= button_to "Retry",
            retry_processing_library_path(@user_episode),
            method: :post,
            class: "inline-flex items-center justify-center w-full sm:w-auto font-serif font-semibold rounded-lg bg-amber text-ink px-5 py-2.5 hover:brightness-105 transition" %>
        <%= button_to "Mark as Done",
            archive_library_path(@user_episode),
            method: :post,
            class: "inline-flex items-center justify-center w-full sm:w-auto font-mono text-sm rounded-lg border border-ink/15 text-ink px-4 py-2 hover:bg-ink/5 transition text-center" %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
      <p class="font-serif text-ink leading-relaxed">
        Processing: <%= @user_episode.processing_status.humanize %>...
      </p>
      <p class="font-mono text-xs text-ink-muted mt-2">This page will update when ready.</p>

      <% if @user_episode.next_retry_at.present? %>
        <div class="mt-3 sm:mt-4 p-3 bg-amber/10 border border-amber/20 rounded font-mono text-xs">
          <p class="font-semibold text-ink uppercase tracking-wide">Retry Debug Info</p>
          <ul class="mt-2 space-y-1 text-ink-soft">
            <li>Retry attempt: <%= @user_episode.retry_count %> / 5</li>
            <li>Next retry at: <%= @user_episode.next_retry_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></li>
            <li>
              Time until retry:
              <% seconds_until = (@user_episode.next_retry_at - Time.current).to_i %>
              <% if seconds_until > 0 %>
                <%= seconds_until / 60 %>m <%= seconds_until % 60 %>s
              <% else %>
                <span class="text-green-700">Executing now...</span>
              <% end %>
            </li>
            <% if @user_episode.last_error_at.present? %>
              <li>Last error: <%= time_ago_in_words(@user_episode.last_error_at) %> ago</li>
            <% end %>
            <% if @user_episode.processing_error.present? %>
              <li class="break-words">Status: <%= @user_episode.processing_error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
