<div class="max-w-4xl mx-auto px-4 py-6 sm:py-8" data-controller="select-all">
  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-2">
    We found <%= @podcasts.count %> podcasts!
  </h1>

  <% if @skipped_count > 0 %>
    <p class="text-ink-soft mb-4">
      <%= @skipped_count %> were already in your library.
    </p>
  <% end %>

  <% if @failed.any? %>
    <details class="mb-4 bg-paper-deep border border-ink/10 rounded-xl p-4">
      <summary class="font-mono text-xs uppercase tracking-wide text-ink-soft cursor-pointer">
        We couldn't find <%= @failed.count %> feeds
      </summary>
      <ul class="mt-2 text-sm text-ink-muted space-y-1">
        <% @failed.each do |failure| %>
          <li><%= failure["feed_url"] %>: <%= failure["error"] %></li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <div class="flex items-center justify-between mb-6">
    <p class="text-ink-soft">Pick 5-10 of your favorites to process right away.</p>
    <button type="button"
            data-action="select-all#toggle"
            class="text-amber hover:underline font-medium">Select all</button>
  </div>

  <%= form_with url: process_favorites_imports_path, method: :post, class: "space-y-6" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @podcasts.each do |podcast| %>
        <label class="flex items-center gap-3 p-3 bg-white rounded-xl border border-ink/10 shadow-sm cursor-pointer hover:border-amber transition">
          <input type="checkbox" name="podcast_ids[]" value="<%= podcast.id %>"
                 data-select-all-target="checkbox"
                 class="h-5 w-5 rounded border-ink/20 accent-[#d9883f]">
          <% if podcast.artwork_url.present? %>
            <img src="<%= podcast.artwork_url %>" alt="<%= podcast.title %>"
                 class="w-10 h-10 rounded-lg object-cover flex-shrink-0">
          <% else %>
            <div class="w-10 h-10 rounded-lg bg-paper-deep flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-ink-muted" fill="currentColor" viewBox="0 0 20 20">
                <path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>
              </svg>
            </div>
          <% end %>
          <span class="font-medium text-sm truncate text-ink"><%= podcast.title %></span>
        </label>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-sm text-ink-soft">
        Estimated cost: $0.46 per episode
      </p>
      <%= f.submit "Process my favorites",
          class: "font-serif font-semibold rounded-lg bg-amber text-ink px-6 py-2.5 hover:brightness-105 transition" %>
    </div>
  <% end %>
</div>
