<div class="max-w-2xl mx-auto px-4 py-6 sm:py-8">
  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-6">Import your podcasts</h1>

  <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
    <p class="text-ink-soft mb-6">
      Export your OPML file from your podcast app and upload it here.
    </p>

    <%= form_with url: import_path, method: :post, multipart: true, class: "space-y-4" do |f| %>
      <div>
        <label for="opml_file" class="block font-mono text-xs uppercase tracking-wide text-ink-muted mb-2">Choose your OPML file</label>
        <input type="file" name="opml_file" id="opml_file" accept=".opml,.xml"
               class="block w-full text-sm text-ink-soft file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:font-medium file:bg-amber/15 file:text-amber hover:file:brightness-105">
      </div>

      <%= f.submit "Upload & Continue",
          class: "font-serif font-semibold rounded-lg bg-amber text-ink px-6 py-2.5 hover:brightness-105 transition" %>
    <% end %>
  </div>
</div>
