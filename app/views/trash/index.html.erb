<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-6">Trash</h1>

  <p class="font-mono text-xs text-ink-muted mb-6">Episodes in trash are automatically deleted after 90 days.</p>

  <% if @user_episodes.any? %>
    <div class="space-y-3">
      <% @user_episodes.each do |user_episode| %>
        <div class="flex gap-4 bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
          <div class="flex-1 min-w-0">
            <h3 class="font-serif font-semibold tracking-tight text-ink-soft truncate"><%= user_episode.title %></h3>
            <p class="font-mono text-xs text-ink-muted mt-1"><%= user_episode.podcast.title %></p>
            <% if user_episode.trashed_at.present? %>
              <p class="font-mono text-xs text-ink-muted mt-1">
                Trashed <%= time_ago_in_words(user_episode.trashed_at) %> ago
              </p>
            <% end %>
          </div>

          <div class="flex-shrink-0 self-center">
            <%= button_to "Restore",
                restore_trash_path(user_episode),
                method: :post,
                class: "text-amber hover:underline font-medium" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-ink-muted">Trash is empty.</p>
    </div>
  <% end %>
</div>
