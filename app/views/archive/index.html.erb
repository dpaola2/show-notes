<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-6">Archive</h1>

  <% if @user_episodes.any? %>
    <div class="space-y-3">
      <% @user_episodes.each do |user_episode| %>
        <div class="flex gap-4 bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
          <div class="flex-1 min-w-0">
            <%= link_to archive_path(user_episode), class: "block" do %>
              <h3 class="font-serif font-semibold tracking-tight text-ink truncate hover:text-amber transition"><%= user_episode.title %></h3>
            <% end %>
            <p class="font-mono text-xs text-ink-muted mt-1"><%= user_episode.podcast.title %></p>
          </div>

          <div class="flex gap-2 flex-shrink-0 self-center">
            <%= link_to "View",
                archive_path(user_episode),
                class: "text-amber hover:underline font-medium" %>
            <%= button_to "Restore",
                restore_archive_path(user_episode),
                method: :post,
                class: "font-mono text-sm text-ink-soft hover:underline" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-ink-muted">No archived episodes yet.</p>
    </div>
  <% end %>
</div>
