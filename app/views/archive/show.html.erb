<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "&larr; Back to Archive".html_safe, archive_index_path, class: "text-amber hover:underline font-medium" %>
  </div>

  <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-2"><%= @episode.title %></h1>
  <p class="font-mono text-xs text-ink-muted mb-6"><%= @episode.podcast.title %></p>

  <% if @episode.summary.present? %>
    <section class="mb-8">
      <h2 class="font-serif text-xl font-semibold tracking-tight text-ink mb-4">Summary</h2>

      <div class="space-y-6">
        <% @episode.summary.sections.each do |section| %>
          <div class="bg-white rounded-xl border border-ink/10 shadow-sm p-5 sm:p-6">
            <h3 class="font-serif font-semibold tracking-tight text-ink mb-2"><%= section["title"] %></h3>
            <p class="text-ink-soft"><%= section["content"] %></p>
          </div>
        <% end %>
      </div>

      <% if @episode.summary.quotes.any? %>
        <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-amber mt-6 mb-4">Notable Quotes</h3>
        <div class="space-y-3">
          <% @episode.summary.quotes.each do |quote| %>
            <blockquote class="border-l-4 border-amber pl-4 py-2 bg-amber/15 rounded-r cursor-pointer hover:brightness-105 transition"
                        data-controller="audio-seek"
                        data-audio-seek-time-value="<%= quote['start_time'] %>"
                        data-action="click->audio-seek#seek">
              <p class="text-ink">"<%= quote["text"] %>"</p>
              <p class="font-mono text-xs text-ink-muted mt-1">
                <%= format_duration(quote["start_time"].to_i) %>
              </p>
            </blockquote>
          <% end %>
        </div>
      <% end %>
    </section>

    <details class="mb-8">
      <summary class="cursor-pointer font-mono text-sm text-ink-soft hover:text-ink transition">Original Show Notes</summary>
      <div class="mt-4 prose prose-sm max-w-none">
        <%= sanitize @episode.description %>
      </div>
    </details>

    <section class="mb-8">
      <h2 class="font-serif text-xl font-semibold tracking-tight text-ink mb-4">Audio</h2>
      <audio controls
             src="<%= @episode.audio_url %>"
             class="w-full"
             data-controller="audio-player">
      </audio>
    </section>

    <div class="flex gap-4">
      <%= button_to "Restore to Library",
          restore_archive_path(@user_episode),
          method: :post,
          class: "inline-flex items-center justify-center font-serif font-semibold rounded-lg bg-amber text-ink px-5 py-2.5 hover:brightness-105 transition" %>
    </div>
  <% end %>
</div>
